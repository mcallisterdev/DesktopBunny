{
  "name": "taco-tanya-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Taco & Tanya desktop pet",
  "author": "Rory McAllister",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "build:win": "npm run icons && npm run build && electron-builder --win --config --publish never",
    "build:mac": "npm run icons && npm run build && electron-builder --mac --universal --config --publish never"
  },
  "dependencies": {
    "pixi.js": "^8.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
